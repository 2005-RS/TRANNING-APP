# ============================================================================
# TRAINING APP (Training Platform) — frontend public configuration
# Not SIGASJ. Port map: docs/frontend/local-environment.md
# Every VITE_* value is compiled into the browser bundle. Never put secrets here.
# ============================================================================

# TRAINING BACKEND
# required | absolute origin of the Training NestJS API, no path, no trailing slash.
# Must equal the backend PORT in backend/.env (backend default: 3000).
# There is no fallback: if this is missing, dev/build/api:generate fail.
# `npm run api:generate` and `npm run dev` verify that this origin serves the
# "Training Platform API" OpenAPI document and refuse a foreign API.
# If another project already uses 3000, run the Training backend on another
# port (PORT=3100 in backend/.env) and set VITE_API_URL=http://localhost:3100.
VITE_API_URL=http://localhost:3000

# optional locally | required for a production deploy
# development | test | production
# When set to production, VITE_API_URL must be https (no http, no trailing slash).
# VITE_APP_ENV=development

# ----------------------------------------------------------------------------
# Reference only (not read from this file)
# ----------------------------------------------------------------------------
# TRAINING FRONTEND  npm run dev       http://localhost:5173  (strictPort)
# PLAYWRIGHT         npm run preview   http://localhost:4173  (strictPort, owned by the E2E suite)
# POSTGRES           backend/docker-compose.yml  localhost:5432
# MINIO API          backend/docker-compose.yml  http://localhost:9100  (private bucket)
# MINIO CONSOLE      backend/docker-compose.yml  http://localhost:9101
#
# PLAYWRIGHT real-backend tests (optional): export E2E_EMAIL / E2E_PASSWORD in
# the shell only (never in a file), and add http://localhost:4173 to the
# backend CORS_ORIGIN list for that run.
