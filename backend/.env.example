# NestJS process
# required | development default shown
NODE_ENV=development
PORT=3000

# Optional. Set true only when the API sits behind a trusted reverse proxy.
# production-required if TLS / client IP is terminated upstream.
# TRUST_PROXY=false

# Optional JSON/urlencoded body cap in bytes (default 262144 = 256 KiB).
# HTTP_JSON_BODY_LIMIT_BYTES=262144

# Optional. Unset = enabled in development/test, disabled in production.
# production: leave unset or false unless operators explicitly need /api/docs.
# SWAGGER_ENABLED=true

# DATABASE
# Must match backend/docker-compose.yml postgres service:
# DATABASE_NAME  -> POSTGRES_DB
# DATABASE_USER  -> POSTGRES_USER
# DATABASE_PASSWORD -> POSTGRES_PASSWORD
# DATABASE_PORT  -> published host port (default 5432)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=training
DATABASE_USER=training
DATABASE_PASSWORD=changeme
DATABASE_SSL=false
# Optional pool / timeout (defaults shown). production-required only if the
# managed provider needs different values.
# DATABASE_POOL_MAX=10
# DATABASE_CONNECT_TIMEOUT_MS=10000
# DATABASE_IDLE_TIMEOUT_MS=10000
# DATABASE_SLOW_QUERY_MS=0

# CORS
# Comma-separated absolute origins. Wildcard * is rejected in production.
# development-only example:
CORS_ORIGIN=http://localhost:5173

# AUTH
# Generate a long local-only JWT secret. Never commit real production secrets.
# production-required: min 32 chars, no placeholder phrases.
JWT_ACCESS_SECRET=replace-with-a-long-random-local-secret-value
JWT_ACCESS_EXPIRES_IN=900
JWT_ACCESS_ISSUER=training-platform
JWT_ACCESS_AUDIENCE=training-platform-api

AUTH_REFRESH_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=refresh_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# SEED
# Optional. Used only by `npm run seed:admin`. Never applied on API boot.
# production-required if you run the seed: not example.com, not known defaults.
# INITIAL_ADMIN_EMAIL=
# INITIAL_ADMIN_PASSWORD=
# INITIAL_ADMIN_FIRST_NAME=
# INITIAL_ADMIN_LAST_NAME=

# OBJECT STORAGE
# S3-compatible private bucket. Local Docker Compose MinIO uses
# training-exercise-media on http://localhost:9100.
# E2E tests force OBJECT_STORAGE_DRIVER=memory unless using test:e2e:minio.
OBJECT_STORAGE_DRIVER=s3
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=training-exercise-media
OBJECT_STORAGE_ACCESS_KEY_ID=replace-with-local-access-key
OBJECT_STORAGE_SECRET_ACCESS_KEY=replace-with-local-secret-key
OBJECT_STORAGE_ENDPOINT=http://localhost:9100
OBJECT_STORAGE_FORCE_PATH_STYLE=true
EXERCISE_MEDIA_UPLOAD_TTL_SECONDS=900
EXERCISE_MEDIA_READ_TTL_SECONDS=120
EXERCISE_VIDEO_MAX_BYTES=262144000
EXERCISE_IMAGE_MAX_BYTES=10485760
PROGRESS_PHOTO_MAX_BYTES=10485760

# TRAINING ASSISTANT (AI chat over WebSocket namespace /chat)
# AI_PROVIDER: mock | deepseek. Unset = mock in development/test.
# production-required: deepseek (mock is rejected in production).
AI_PROVIDER=mock
# Required when AI_PROVIDER=deepseek. Backend-only secret: never put it in the
# frontend, a VITE_* variable, logs, or git.
DEEPSEEK_API_KEY=
# Official OpenAI-compatible base URL: https://api.deepseek.com (https required in production).
DEEPSEEK_BASE_URL=
# Current official models: deepseek-flash | deepseek-v4-pro
DEEPSEEK_MODEL=
# Optional (defaults shown).
# AI_REQUEST_TIMEOUT_MS=30000
# AI_MAX_HISTORY_MESSAGES=20
# AI_MAX_OUTPUT_TOKENS=800
# AI_RATE_LIMIT_PER_MINUTE=12
# Anonymous public-website assistant (namespace /public-chat).
# AI_PUBLIC_CHAT_ENABLED=true
# AI_PUBLIC_RATE_LIMIT_PER_MINUTE=4
# Global cap across all visitors per UTC day; bounds provider cost.
# AI_PUBLIC_DAILY_MESSAGE_LIMIT=300

# OBSERVABILITY
# DATABASE_SLOW_QUERY_MS above. Leave 0 unless diagnosing slow SQL.
# Production logs: error/warn/log. Request logs never include bodies or tokens.
